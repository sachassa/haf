{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cat .claude/hooks/completeness-reminder.txt 2>/dev/null",
            "timeout": 5,
            "statusMessage": "완전성·사실 주장 규율 로드"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/memory-guard.sh",
            "timeout": 5,
            "statusMessage": "메모리 자동 클린 가드"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/md-budget-guard.sh",
            "timeout": 10,
            "statusMessage": "md 예산 가드"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/history-reaccum-guard.sh",
            "timeout": 20,
            "statusMessage": "이력 재퇴적 가드"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "PYTHONIOENCODING=utf-8 python orchestration/adapters/claude/pretooluse_design_guard.py",
            "timeout": 15,
            "statusMessage": "설계완성도 백스톱(src/ 차단)"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PYTHONIOENCODING=utf-8 python .claude/hooks/binary_state_guard.py",
            "timeout": 10,
            "statusMessage": "이진 원칙 가드(상태·근거)"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PYTHONIOENCODING=utf-8 python orchestration/adapters/claude/pretooluse_lane_guard.py",
            "timeout": 15,
            "statusMessage": "레인 가드(경량 레인 접점 차단)"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PYTHONIOENCODING=utf-8 python discovery/adapters/claude/pretooluse_coverage_guard.py",
            "timeout": 15,
            "statusMessage": "커버리지 백스톱(축 4 미심문 Contract 차단)"
          }
        ]
      }
    ]
  }
}
