{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cat .claude/hooks/completeness-reminder.txt 2>/dev/null",
            "timeout": 5,
            "statusMessage": "완전성·사실 주장 규율 로드"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/memory-guard.sh",
            "timeout": 5,
            "statusMessage": "메모리 자동 클린 가드"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/orchestration/adapters/claude/pretooluse_design_guard.py\"",
            "timeout": 15,
            "statusMessage": "설계완성도 백스톱(src/ 차단)"
          }
        ]
      }
    ]
  }
}
